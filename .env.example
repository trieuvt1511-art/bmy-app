# YumGo environment variables
# Copy to .env.local for local dev, or set in Vercel Dashboard → Settings → Environment Variables

# -----------------------------------------------------------------------------
# Groq API key — primary translation engine (Llama 3.3 70B, FREE)
# -----------------------------------------------------------------------------
# Signup at https://console.groq.com (free, no credit card)
# Free tier: 14,400 requests/day, 30 req/min — far more than YumGo needs
# because Vercel KV caches each unique string permanently.
#
# Llama 3.3 70B is significantly smoother than Google Translate for
# culinary content (it understands "sauté → xào", "ground beef → thịt bò xay",
# etc.) and speaks natural Vietnamese/Spanish/Chinese cooking terminology.
#
# If GROQ_API_KEY is missing or the API errors, the app automatically falls
# back to the free Google Translate web endpoint — no breakage.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Vercel KV (Upstash Redis) — shared translation cache
# -----------------------------------------------------------------------------
# Each unique English string is translated once and cached in Vercel KV.
# Every user on every device then reads from the shared cache (~50ms).
#
# Without KV the app still works, it just re-translates on every request.
#
# To enable: Vercel Dashboard → Project → Storage → Create Database → KV (Redis)
# Vercel auto-injects these env vars — no manual paste needed.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# -----------------------------------------------------------------------------
# Cron secret — protects /api/refresh-trending
# -----------------------------------------------------------------------------
# Random string. Set the same value in Vercel env and Vercel Cron will auto
# send Authorization: Bearer <CRON_SECRET> for each scheduled run.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=replace_with_random_hex_string
